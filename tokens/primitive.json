{
  "$schema": "https://schemas.designtokens.org/2023",
  "$description": "AmpliForge PRIMITIVE (reference) tokens. Raw values only — never consumed directly by components. Semantic tokens reference these. Brand anchors: blue.600=#0D66D0, purple.500=#9256D9, crimson.500=#E34850, gold.500=#D4AF37.",
  "color": {
    "$type": "color",
    "blue": {
      "50":  { "$value": "#eaf2fc" },
      "100": { "$value": "#d0e1f8" },
      "200": { "$value": "#a6c7f0" },
      "300": { "$value": "#74a6e6" },
      "400": { "$value": "#3d82db" },
      "500": { "$value": "#1b72d6" },
      "600": { "$value": "#0d66d0" },
      "700": { "$value": "#0b54ac" },
      "800": { "$value": "#0c468b" },
      "900": { "$value": "#0e3b72" },
      "950": { "$value": "#0a2647" }
    },
    "purple": {
      "50":  { "$value": "#f4eefc" },
      "100": { "$value": "#e7daf8" },
      "200": { "$value": "#d0b8f1" },
      "300": { "$value": "#b98fe9" },
      "400": { "$value": "#a570e1" },
      "500": { "$value": "#9256d9" },
      "600": { "$value": "#7e3fc9" },
      "700": { "$value": "#6832a6" },
      "800": { "$value": "#522982" },
      "900": { "$value": "#402066" },
      "950": { "$value": "#2a1444" }
    },
    "crimson": {
      "50":  { "$value": "#fdeced" },
      "100": { "$value": "#fbd5d7" },
      "200": { "$value": "#f7abb0" },
      "300": { "$value": "#f17e85" },
      "400": { "$value": "#ea5b63" },
      "500": { "$value": "#e34850" },
      "600": { "$value": "#c7343c" },
      "700": { "$value": "#a32930" },
      "800": { "$value": "#822227" },
      "900": { "$value": "#6b1e22" },
      "950": { "$value": "#400f12" }
    },
    "gold": {
      "50":  { "$value": "#fbf6e7" },
      "100": { "$value": "#f6ebc4" },
      "200": { "$value": "#edd78b" },
      "300": { "$value": "#e4c558" },
      "400": { "$value": "#dcb944" },
      "500": { "$value": "#d4af37" },
      "600": { "$value": "#b8942a" },
      "700": { "$value": "#937323" },
      "800": { "$value": "#6f5820" },
      "900": { "$value": "#5a481e" },
      "950": { "$value": "#33280f" }
    },
    "neutral": {
      "0":   { "$value": "#ffffff" },
      "50":  { "$value": "#fafafa" },
      "100": { "$value": "#f4f4f5" },
      "200": { "$value": "#e4e4e7" },
      "300": { "$value": "#d4d4d8" },
      "400": { "$value": "#a1a1aa" },
      "500": { "$value": "#71717a" },
      "600": { "$value": "#52525b" },
      "700": { "$value": "#3f3f46" },
      "800": { "$value": "#27272a" },
      "850": { "$value": "#202020" },
      "900": { "$value": "#181818" },
      "925": { "$value": "#111111" },
      "950": { "$value": "#0a0a0a" }
    },
    "green": {
      "500": { "$value": "#10b981" },
      "600": { "$value": "#059669" }
    },
    "amber": {
      "500": { "$value": "#f59e0b" },
      "600": { "$value": "#d97706" }
    },
    "red": {
      "500": { "$value": "#ef4444" },
      "600": { "$value": "#dc2626" }
    },
    "sky": {
      "500": { "$value": "#3b82f6" },
      "600": { "$value": "#2563eb" }
    }
  },
  "gradient": {
    "$type": "other",
    "hero":   { "$value": "linear-gradient(135deg, #0d66d0, #9256d9)" },
    "gold":   { "$value": "linear-gradient(135deg, #d4af37, #ffd700)" },
    "accent": { "$value": "linear-gradient(135deg, #e34850, #ff6b6b)" }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "0":  { "$value": "0px" },
      "1":  { "$value": "2px" },
      "2":  { "$value": "4px" },
      "3":  { "$value": "8px" },
      "4":  { "$value": "12px" },
      "5":  { "$value": "16px" },
      "6":  { "$value": "20px" },
      "7":  { "$value": "24px" },
      "8":  { "$value": "32px" },
      "9":  { "$value": "40px" },
      "10": { "$value": "48px" },
      "11": { "$value": "56px" },
      "12": { "$value": "64px" },
      "14": { "$value": "80px" },
      "16": { "$value": "96px" },
      "20": { "$value": "128px" }
    },
    "radius": {
      "xs":   { "$value": "4px" },
      "sm":   { "$value": "6px" },
      "md":   { "$value": "12px" },
      "lg":   { "$value": "20px" },
      "xl":   { "$value": "28px" },
      "full": { "$value": "9999px" }
    },
    "layout": {
      "nav-height":              { "$value": "72px" },
      "sidebar-width":           { "$value": "280px" },
      "sidebar-collapsed-width": { "$value": "76px" },
      "container-max":           { "$value": "1280px" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": "var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif" },
      "mono": { "$value": "var(--font-geist-mono), ui-monospace, SFMono-Regular, monospace" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "fontSize": {
      "$type": "dimension",
      "xs":      { "$value": "12px" },
      "sm":      { "$value": "14px" },
      "base":    { "$value": "16px" },
      "lg":      { "$value": "18px" },
      "xl":      { "$value": "20px" },
      "2xl":     { "$value": "24px" },
      "3xl":     { "$value": "32px" },
      "4xl":     { "$value": "40px" },
      "5xl":     { "$value": "56px" },
      "display": { "$value": "72px" }
    },
    "lineHeight": {
      "tight":   { "$value": "1.08" },
      "snug":    { "$value": "1.2" },
      "normal":  { "$value": "1.5" },
      "relaxed": { "$value": "1.7" }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tighter": { "$value": "-0.04em" },
      "tight":   { "$value": "-0.02em" },
      "normal":  { "$value": "0em" },
      "wide":    { "$value": "0.06em" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04)" },
    "md": { "$value": "0 4px 16px rgba(0,0,0,0.08), 0 2px 6px rgba(0,0,0,0.04)" },
    "lg": { "$value": "0 12px 40px rgba(0,0,0,0.10), 0 4px 12px rgba(0,0,0,0.06)" },
    "glow-blue":   { "$value": "0 0 30px rgba(13,102,208,0.25)" },
    "glow-purple": { "$value": "0 0 30px rgba(146,86,217,0.25)" },
    "glow-gold":   { "$value": "0 0 20px rgba(212,175,55,0.30)" }
  },
  "blur": {
    "$type": "dimension",
    "sm": { "$value": "12px" },
    "md": { "$value": "20px" },
    "lg": { "$value": "28px" }
  },
  "zIndex": {
    "$type": "number",
    "base":     { "$value": 0 },
    "raised":   { "$value": 10 },
    "sticky":   { "$value": 1100 },
    "overlay":  { "$value": 1200 },
    "modal":    { "$value": 1300 },
    "popover":  { "$value": 1400 },
    "toast":    { "$value": 1500 }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast":    { "$value": "120ms" },
      "base":    { "$value": "200ms" },
      "slow":    { "$value": "320ms" },
      "slower":  { "$value": "500ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":    { "$value": [0.2, 0, 0, 1] },
      "emphasized":  { "$value": [0.3, 0, 0, 1] },
      "decelerate":  { "$value": [0, 0, 0, 1] },
      "accelerate":  { "$value": [0.3, 0, 1, 1] }
    }
  }
}
